#!/bin/sh
# dsh-gacha-calendar pre-commit hook — UTF-8 BOM guard + src/lib 一致性守卫
#
# WHY: DSH desktop's plugin-config phase reads package.json with a raw JSON.parse
# that does NOT strip a UTF-8 BOM. A BOM written by PowerShell
#   Set-Content -Encoding UTF8   (PS 5.1 default = UTF-8 WITH BOM)
# broke DSH startup with:  Unexpected token '﻿', "﻿{\n  "nam"... is not valid JSON
# Node's require() strips BOM, so node --check/require never caught it.
#
# This hook blocks any staged text file that begins with the UTF-8 BOM bytes
# (EF BB BF). It protects .json (plugin manifests) plus other text types.
#
# Activation (one time per clone, repo-local):
#   npm run setup:hooks        # 等价于 git config core.hooksPath .githooks
# Skip for a single commit if ever needed:
#   DSH_SKIP_BOM_CHECK=1 git commit ...      # 只跳过 BOM 检查
#   DSH_SKIP_BUILD_CHECK=1 git commit ...    # 只跳过 src/lib 一致性检查
skip_bom=${DSH_SKIP_BOM_CHECK:-}
skip_build=${DSH_SKIP_BUILD_CHECK:-}

fail=0

# BOM 扫描交给 Node（tools/check-bom.mjs）：
#   原实现用 `... | while IFS= read -r -d '' f; do` —— `read -d` 是 **bash 专有**，
#   Ubuntu 的 /bin/sh 是 dash ⇒ 直接 `read: Illegal option -d`，循环不执行 ⇒ 守卫**静默失效**
#   （2026-11-14 在 WSL/Ubuntu 实测：带 BOM 的文件被成功提交；macOS bash3.2 与 Git Bash 反而正常）。
#   改成 Node 后三平台同一份逻辑，并且能进 CI 单测。
if [ -z "$skip_bom" ]; then
	if command -v node >/dev/null 2>&1; then
		hook_root=$(git rev-parse --show-toplevel 2>/dev/null) || hook_root=.
		node "$hook_root/tools/check-bom.mjs" || fail=1
	else
		echo "WARN: 未找到 node，跳过 UTF-8 BOM 检查" >&2
	fi
fi

# ---- src/lib 一致性守卫 ----
# WHY: src/ 是唯一真源，lib/ 与 packages/core/ 都只是构建产物。若直接改产物而忘了改 src/，下次 build
# 就会把手改悄悄冲掉（本仓库历史上正是这么积累技术债的）。所以提交涉及 src/**、lib/**、packages/**
# 或 build.mjs 时，强制跑一次 `node build.mjs --check`。
if [ -z "$skip_build" ]; then
	if git diff --cached --name-only --diff-filter=ACM | grep -qE '^(src/|lib/|packages/|build\.mjs$)'; then
		if command -v node >/dev/null 2>&1; then
			if ! node build.mjs --check >/dev/null 2>&1; then
				echo "ERROR: lib/ 与 src/ 不一致 —— src/ 是唯一真源，请不要直接改 lib/。Commit blocked." >&2
				echo "  Fix: node build.mjs && git add lib/" >&2
				echo "  (Or, if you really must ship a hand-edited lib/: DSH_SKIP_BUILD_CHECK=1 git commit ...)" >&2
				fail=1
			fi
		else
			echo "WARN: 未找到 node，跳过 lib/ 与 src/ 一致性检查" >&2
		fi
	fi
fi

exit $fail
